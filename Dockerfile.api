FROM python:3.13-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl git && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip

# Install ONLY core torch for AMD (stripping out the broken torchaudio package)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/rocm7.14 --extra-index-url https://pypi.org/simple

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/ ./api
COPY scripts/ ./scripts
EXPOSE 8000
CMD ["uvicorn", "api.agent:app", "--host", "0.0.0.0", "--port", "8000"]
